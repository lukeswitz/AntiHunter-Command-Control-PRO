# Backend
NODE_ENV=production
PORT=3000
LISTEN_HOST=0.0.0.0
TRUST_PROXY=1
HTTP_PREFIX=api
LOG_LEVEL=info
ALLOW_FOREVER=true
ALLOW_ERASE_FORCE=false

# Database
DATABASE_URL=postgresql://command_center:command_center@postgres:5432/command_center
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Serial (leave blank for UI-only usage)
SERIAL_DEVICE=
SERIAL_BAUD=115200
SERIAL_PROTOCOL=meshtastic-rewrite

# Mail (optional)
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Command Center <no-reply@example.com>"
MAIL_PREVIEW=true

# Security defaults
SECURITY_APP_URL=http://localhost:8080
INVITATION_EXPIRY_HOURS=48
PASSWORD_RESET_EXPIRY_HOURS=12

# Socket / Web
WS_MAX_CLIENTS=200

# Phone push notifications (off while blank). Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Remote access (docker compose --profile remote up -d). Tailscale admin > Settings > Keys, tagged tag:ahcc
TS_AUTHKEY=
TS_HOSTNAME=ahcc
# Tailscale logins allowed through the tailnet entrance, comma separated. Empty = nobody.
TS_ALLOWED_LOGINS=

# ntfy (self-hosted recommended; the server can read messages). Full topic URL + access token
NTFY_URL=
NTFY_TOKEN=

# Signal, end-to-end encrypted. Link once with a temporary port:
#   docker compose --profile signal run --rm -p 127.0.0.1:8090:8080 signal-api
#   open http://127.0.0.1:8090/v1/qrcodelink?device_name=ahcc, scan from Signal > Settings > Linked devices, then Ctrl-C
#   docker compose --profile signal up -d   (no published port; only the backend can reach it)
SIGNAL_API_URL=http://signal-api:8080
SIGNAL_NUMBER=
SIGNAL_RECIPIENTS=

# Matrix (message is not end-to-end encrypted; use your own homeserver)
MATRIX_HOMESERVER_URL=
MATRIX_ACCESS_TOKEN=
MATRIX_ROOM_ID=

# Matter device for Apple Home / Google Home / Alexa / SmartThings. Pairing code is printed in the backend log.
AHCC_MATTER_ENABLED=false
AHCC_MATTER_PASSCODE=
# bridge (default): named sensors "AntiHunter Alert"/"AntiHunter Critical". flat: two unnamed sensors (pairings made before the bridge layout)
AHCC_MATTER_LAYOUT=bridge
# macOS: signed standalone binary from tools/matter/build.sh; allow only this app in the firewall
AHCC_MATTER_BIN=
# Listen and announce only on this interface (e.g. en0, eth0)
AHCC_MATTER_INTERFACE=

# Encrypts alert tokens and the push signing key in the database. Blank = random key file in the remote-secrets volume.
REMOTE_ALERTS_SECRET_KEY=
